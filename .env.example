# Optional: enables the Reown wallet modal and WalletConnect. Without this, the
# app still connects to an injected browser wallet such as MetaMask.
NEXT_PUBLIC_REOWN_PROJECT_ID=YOUR_REOWN_PROJECT_ID
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Robinhood testnet mock infrastructure (defaults shown). Explicit zero disables
# Multiply. The exchange must be MockSPYExchange, NOT ExchangeHelpersV2.
NEXT_PUBLIC_LEVERAGE_ZAPPER_ADDRESS=0xf63a41A0C8fDB81704C92Ba39eAcfB11f8C3FD87
NEXT_PUBLIC_MULTIPLY_EXCHANGE_ADDRESS=0x6AfC499c52571F03272Fa6a4FBba0b73674f7f4c
# Deprecated NEXT_PUBLIC_MULTIPLY_QUOTER_ADDRESS is a fallback exchange override
# only when MULTIPLY_EXCHANGE is unset/empty. Remove old quote-helper addresses.
# Informational: leverage inherits gas compensation and does not call this address.
NEXT_PUBLIC_GAS_COMP_ZAPPER_ADDRESS=0x2Ce45DC74397aE3A5082cc822A9A978fd387429b

# Optional: enables PostHog product analytics. Change the host for EU Cloud or
# a self-hosted PostHog instance.
NEXT_PUBLIC_POSTHOG_KEY=YOUR_POSTHOG_PROJECT_API_KEY
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
# Accounts GraphQL API used to discover the signing key and renew account secrets.
NEXT_PUBLIC_ACCOUNTS_URL=https://accounts.superposition.so
# Florin's current FreshBackwards resolver uses the zero-address authority.
NEXT_PUBLIC_ACCOUNT_AUTHORITY_ADDR=0x0000000000000000000000000000000000000000

# Current Robinhood testnet deployment: florin-contracts/contracts/addresses/46630.json.
# Backend SPY-branch configuration (apply to the service environment as well).
SPN_CHAIN_ID=46630
SPN_SUPERPOSITION_URL=https://rpc.testnet.chain.robinhood.com
SPN_GETH_URL=https://rpc.testnet.chain.robinhood.com
SPN_BORROWER_OPERATIONS=0xfea06161dbd14374ee6a746eae3502a1a6741990
SPN_WETH_ADDR=0x7943e237c7F95DA44E0301572D358911207852Fa
# Protocol emitters only: do not include collateral ERC-20s or WETH.
SPN_LIQUITY_ADDRS=0x1f93de989cd9d30b2c31f3227769632729858196,0xeb264317b915cb1a8c8e3ca27dd270d947bba968,0xf00a7eb2cf0d8dee71788bbb99d57d8a4ef98775,0xfea06161dbd14374ee6a746eae3502a1a6741990,0x43a5c00937b4aec0b56f0e12dedd2247e4a454f7,0x47697a6400bd3848519f469bbc0824b954826e66,0x83311690476dfa9239b55e732b4b6638a15142df,0x9543b191c66c4fa68b9b7888df65b661842ace1b,0xc1ebb33678176d7fb5c8fef3ba5a610d50bacc63,0xe361393f4d0f3b40eca34c7a83e27e4b5dcfa1c3
