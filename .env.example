# Beta gate. Copy to .env.local for local development.
#
# When this is unset:
#   development  -> no gate, the site is open
#   production   -> the gate is closed with a "not configured" notice, so a
#                   deploy that forgot the variable is locked rather than
#                   silently public
#
# Changing this value invalidates every existing session: the password is the
# key the session cookie is signed with.
BETA_PASSWORD=change-me
