# Optional: enables the Reown wallet modal and WalletConnect. Without this, the
# app still connects to an injected browser wallet such as MetaMask.
NEXT_PUBLIC_REOWN_PROJECT_ID=YOUR_REOWN_PROJECT_ID
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Robinhood testnet mock infrastructure (defaults shown). Explicit zero disables
# Multiply. The exchange must be MockSPYExchange, NOT ExchangeHelpersV2.
NEXT_PUBLIC_LEVERAGE_ZAPPER_ADDRESS=0xf63a41A0C8fDB81704C92Ba39eAcfB11f8C3FD87
NEXT_PUBLIC_MULTIPLY_EXCHANGE_ADDRESS=0x6AfC499c52571F03272Fa6a4FBba0b73674f7f4c
# Deprecated NEXT_PUBLIC_MULTIPLY_QUOTER_ADDRESS is a fallback exchange override
# only when MULTIPLY_EXCHANGE is unset/empty. Remove old quote-helper addresses.
# Informational: leverage inherits gas compensation and does not call this address.
NEXT_PUBLIC_GAS_COMP_ZAPPER_ADDRESS=0x2Ce45DC74397aE3A5082cc822A9A978fd387429b

# Borrow USDG (46630). Replace with the new USDGZapper deployment, then rebuild.
# Default replacement deployment; wiring and allowance are validated at runtime.
# The zapper must approve FUSD to 0xf7ab3619841813FFdb84aE0c8cAA2E31573d53d2,
# and that exchange must hold enough USDG. A wallet SPY permit cannot fix either.
NEXT_PUBLIC_USDG_ZAPPER_ADDRESS=0xfE1dc1e65aa7CF4D35BdF46326d3a9C92b01101d

# Optional: enables PostHog product analytics. Change the host for EU Cloud or
# a self-hosted PostHog instance.
NEXT_PUBLIC_POSTHOG_KEY=YOUR_POSTHOG_PROJECT_API_KEY
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
# Accounts GraphQL API used to discover the signing key and renew account secrets.
NEXT_PUBLIC_ACCOUNTS_URL=https://accounts.superposition.so
# Florin's current FreshBackwards resolver uses the zero-address authority.
NEXT_PUBLIC_ACCOUNT_AUTHORITY_ADDR=0x0000000000000000000000000000000000000000

# Current Robinhood testnet deployment: florin-contracts/contracts/addresses/46630.json.
# Backend SPY-branch configuration (apply to the service environment as well).
SPN_CHAIN_ID=46630
SPN_SUPERPOSITION_URL=https://rpc.testnet.chain.robinhood.com
SPN_GETH_URL=https://rpc.testnet.chain.robinhood.com
SPN_BORROWER_OPERATIONS=0xfea06161dbd14374ee6a746eae3502a1a6741990
SPN_WETH_ADDR=0x7943e237c7F95DA44E0301572D358911207852Fa
# Required backend database connection (comma-separated connections supported).
SPN_TIMESCALE=postgres://postgres:postgres@localhost:5432/florin?sslmode=disable
# Required named Liquity emitters for the SPY branch. Every role must have one
# distinct, nonzero address; collateral ERC-20s and WETH are not protocol emitters.
SPN_BOLD_TOKEN_ADDR=0x1f93de989cd9d30b2c31f3227769632729858196
SPN_COLLATERAL_REGISTRY_ADDR=0xeb264317b915cb1a8c8e3ca27dd270d947bba968
SPN_ADDRESSES_REGISTRY_ADDR=0xd48655f1fc1a6648246cc9802c6ee5190c93fec0
SPN_ACTIVE_POOL_ADDR=0xf00a7eb2cf0d8dee71788bbb99d57d8a4ef98775
SPN_BORROWER_OPERATIONS_ADDR=0xfea06161dbd14374ee6a746eae3502a1a6741990
SPN_COLL_SURPLUS_POOL_ADDR=0x43a5c00937b4aec0b56f0e12dedd2247e4a454f7
SPN_DEFAULT_POOL_ADDR=0x47697a6400bd3848519f469bbc0824b954826e66
SPN_SORTED_TROVES_ADDR=0x83311690476dfa9239b55e732b4b6638a15142df
SPN_STABILITY_POOL_ADDR=0x9543b191c66c4fa68b9b7888df65b661842ace1b
SPN_TROVE_MANAGER_ADDR=0xc1ebb33678176d7fb5c8fef3ba5a610d50bacc63
SPN_TROVE_NFT_ADDR=0xe361393f4d0f3b40eca34c7a83e27e4b5dcfa1c3
SPN_PRICE_FEED_ADDR=0xb7dc3a2596e9a0571b6e104d2f1a3d35b0653862
# Optional governance proxy (NOT implementation). Blank disables its indexing;
# when configured it must also be nonzero and distinct from every other role.
SPN_GOVERNANCE_ADDR=
# Required Yearn roles. Deployment addresses are not supplied in the Liquity
# manifest: set both before starting backend services. No address-list fallback.
SPN_YEARN_VAULT_ADDR=
SPN_YEARN_VAULT_FACTORY_ADDR=
