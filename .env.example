# Required: ZeroDev embedded wallet project. Enable Robinhood Chain Testnet
# (46630), configure authentication methods and allowlist this app's origin in
# the ZeroDev dashboard.
NEXT_PUBLIC_ZERODEV_PROJECT_ID=YOUR_ZERODEV_PROJECT_ID
# Optional ZeroDev AA host and chain RPC overrides.
NEXT_PUBLIC_ZERODEV_AA_HOST=https://rpc.zerodev.app
NEXT_PUBLIC_ROBINHOOD_TESTNET_RPC_URL=https://rpc.testnet.chain.robinhood.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional: enables PostHog product analytics. Change the host for EU Cloud or
# a self-hosted PostHog instance.
NEXT_PUBLIC_POSTHOG_KEY=YOUR_POSTHOG_PROJECT_API_KEY
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
