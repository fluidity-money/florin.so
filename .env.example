# Beta gate. Copy to .env.local for local development.
#
# When this is unset:
#   development  -> no gate, the site is open
#   production   -> the gate is closed with a "not configured" notice, so a
#                   deploy that forgot the variable is locked rather than
#                   silently public
#
# Changing this value invalidates every existing session: the password is the
# key the session cookie is signed with.
BETA_PASSWORD=change-me

# Optional: enables the Reown wallet modal and WalletConnect. Without this, the
# app still connects to an injected browser wallet such as MetaMask.
NEXT_PUBLIC_REOWN_PROJECT_ID=YOUR_REOWN_PROJECT_ID
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional: enables PostHog product analytics. Change the host for EU Cloud or
# a self-hosted PostHog instance.
NEXT_PUBLIC_POSTHOG_KEY=YOUR_POSTHOG_PROJECT_API_KEY
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
